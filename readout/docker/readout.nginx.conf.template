server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  gzip on;
  gzip_types text/html text/javascript application/javascript application/json text/csv;
  gzip_min_length 1024;

  # management only: never indexed, never cached, never framed by other sites
  add_header X-Robots-Tag "noindex, nofollow" always;
  add_header Cache-Control "no-store" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;

  # Production: put company SSO in front of this whole server (auth_request to an oauth2-proxy, or the
  # load balancer's identity layer) and leave RO_READ_TOKEN empty. Only the read API is proxied:
  # the game's write endpoints are not reachable from the readout origin.
  location /api/v1/read/ {
    proxy_pass ${API_UPSTREAM}/v1/read/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
  location /api/ { return 404; }

  # option and floor pictures from the game: same names for the same picture, cache a day
  location /assets/ { add_header Cache-Control "public, max-age=86400" always; add_header X-Robots-Tag "noindex, nofollow" always; }

  location / { try_files $uri /index.html; }
}
