# Production on your own machine. ./init.sh copies this to .env and fills in the three secrets.
POSTGRES_PASSWORD=
RATE_LIMIT_SECRET=
# The invite. The game page carries it, so anyone with the game's address can play.
PILOT_TOKEN=
PILOT_ID=pilot-1
PILOT_SITE=site-1
GAME_VERSION=pilot-1.0

# Where players and managers reach it. The default is this computer only.
# On the office network, use this machine's address:
#   GAME_ADDRESS=https://192.168.1.20
#   READOUT_ADDRESS=https://192.168.1.20:8443
# With domain names pointed at this machine (ports 80 and 443 reachable from the internet):
#   GAME_ADDRESS=play.example.kr
#   READOUT_ADDRESS=readout.example.kr
GAME_ADDRESS=https://localhost
READOUT_ADDRESS=https://localhost:8443

# internal: Caddy's own certificate authority. Browsers warn until its root is trusted (README.md).
# An email address instead: real Let's Encrypt certificates (needs the domain names above).
CADDY_TLS=internal

# Manager logins (from managers.caddy) that may download the CSV export, comma separated.
READ_EXPORTERS=
# Raw events are deleted this many months after the pilot ends (an open question in the spec).
RETENTION_MONTHS=3
BACKUP_KEEP_DAYS=14
