# Copy to .env and change before running on any server.
POSTGRES_PASSWORD=change-this-password
RATE_LIMIT_SECRET=change-this-secret
API_PORT=8000
# The game's web address, once it has one, e.g. https://play.example.kr
CORS_ORIGINS=
# Behind Caddy, nginx or a load balancer:
TRUST_PROXY=false
RETENTION_MONTHS=3
